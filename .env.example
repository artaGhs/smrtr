# Server-side only. Copy to .env.local and never commit credentials.
# OpenRouter takes precedence when its key is set; pick a model with strict structured-output support.
OPENROUTER_API_KEY=
SMRTR_OPENROUTER_MODEL=openai/gpt-4.1
# Fallback direct connection, used when no OpenRouter key is configured.
OPENAI_API_KEY=
SMRTR_MODEL=gpt-4.1
# Optional end-to-end generation timeout, in milliseconds (1000–180000).
SMRTR_GENERATION_TIMEOUT_MS=120000
